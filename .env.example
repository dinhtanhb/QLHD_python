# Django
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database (use a non-root MySQL account in real environments)
DB_ENGINE=mysql
DB_NAME=qlhd
DB_USER=qlhd_app
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=60

# Với DEBUG=False, ứng dụng mặc định chuyển sang HTTPS, bật HSTS 1 giờ
# và chỉ gửi session/CSRF cookie qua HTTPS. Không ghi đè bằng False khi triển khai.
# Chỉ bật dòng sau nếu reverse proxy tin cậy đã đặt X-Forwarded-Proto chính xác:
# SECURE_PROXY_SSL_HEADER=True
# Sau khi xác minh toàn bộ truy cập HTTPS, có thể tăng thời hạn HSTS:
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# SECURE_HSTS_PRELOAD=False
